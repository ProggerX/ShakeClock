<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ShakeClock" parent="Theme.Material3.DayNight.NoActionBar" />

    <style name="ShakeClockSectionHeader">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">28dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>

    <style name="ShakeClockBigValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">44sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
</resources>
